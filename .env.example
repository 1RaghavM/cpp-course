# Supabase
# Postgres + Auth (magic-link). URL + anon key are public; service role bypasses RLS — server-only.
NEXT_PUBLIC_SUPABASE_URL=<placeholder>
NEXT_PUBLIC_SUPABASE_ANON_KEY=<placeholder>
SUPABASE_SERVICE_ROLE_KEY=<placeholder>

# NOTE: no ANTHROPIC_API_KEY is needed. Lesson summaries, exercises and concept
# checks are generated out-of-band and committed under scripts/regenerated/v2/;
# the app only ever reads them from Postgres. There is no live generation path.

# Judge0 (C++ sandbox via RapidAPI shared host — TODO: self-host before prod)
# Currently pointed at the RapidAPI judge0-ce shared host. Replace with self-hosted gVisor VM before launch.
JUDGE0_URL=<placeholder>
JUDGE0_AUTH_TOKEN=<placeholder>

# BYOAK: users provide their own Gemini key via the tutor setup screen.
# GOOGLE_GENERATIVE_AI_API_KEY is no longer needed.
# Encryption secret for storing user API keys. Generate with: openssl rand -base64 32
API_KEY_ENCRYPTION_SECRET=<placeholder>

# GitHub Sync (OAuth App) — register at https://github.com/settings/developers
# Authorization callback URL: <your-site>/api/github/callback  (scope requested: public_repo)
# Token encryption reuses API_KEY_ENCRYPTION_SECRET above (no new secret needed).
GITHUB_OAUTH_CLIENT_ID=<placeholder>
GITHUB_OAUTH_CLIENT_SECRET=<placeholder>

# Statsig (analytics + feature gates). The server key is required at runtime —
# lib/statsig/server.ts throws without it.
NEXT_PUBLIC_STATSIG_CLIENT_KEY=<placeholder>
STATSIG_SERVER_SECRET_KEY=<placeholder>

# ---------------------------------------------------------------------------
# Local git pre-commit hook
# ---------------------------------------------------------------------------
# A pre-commit hook lives at .githooks/pre-commit that blocks committing any
# .env or .env.local file (only .env.example is allowed). Enable it locally:
#
#   git config core.hooksPath .githooks
#
# This is a per-clone setting; each contributor must run it once.
